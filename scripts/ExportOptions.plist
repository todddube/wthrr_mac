<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Export method for direct distribution (outside Mac App Store).
        Use "developer-id" when distributing via GitHub / your own website.
        Use "mac-application" for Mac App Store builds.
    -->
    <key>method</key>
    <string>developer-id</string>

    <key>teamID</key>
    <string>YT8HJFH9K8</string>

    <!-- Automatically manage signing for the export -->
    <key>signingStyle</key>
    <string>automatic</string>

    <!--
        Set to true to submit for notarization inline with export.
        Requires Apple ID credentials or an App Store Connect API key
        configured in Xcode Organizer / xcodebuild.
    -->
    <key>notarize</key>
    <false/>

    <!-- Strip Swift stdlib if it's already in the OS (reduces app size) -->
    <key>stripSwiftSymbols</key>
    <true/>

    <!-- Compile Bitcode (no-op for Apple Silicon targets, harmless) -->
    <key>compileBitcode</key>
    <false/>
</dict>
</plist>
